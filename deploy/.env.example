# ─── Application ───────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=info

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=okbox
POSTGRES_PASSWORD=okbox
POSTGRES_DB=okbox
POSTGRES_PORT=5432

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── MinIO ─────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=okbox
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production

# ─── Nginx ────────────────────────────────────────────────────
NGINX_PORT=80
