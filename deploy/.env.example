# ─── Application ───────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=info

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=okbox
POSTGRES_PASSWORD=okbox
POSTGRES_DB=okbox

# ─── MinIO ─────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=okbox

# ─── Backend ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ─── Nginx（唯一对外暴露端口）─────────────────────────────────
NGINX_PORT=80
